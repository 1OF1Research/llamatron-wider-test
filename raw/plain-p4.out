```python
def median_or_none(values):
    if not values:
        return None
    s = sorted(values)
    n = len(s)
    mid = n // 2
    return s[mid] if n % 2 else (s[mid-1] + s[mid]) / 2

# Example: median_or_none([4, 1, 3, 2])  # returns 2.5
```

