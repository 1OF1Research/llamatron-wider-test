```python
def second_largest(numbers):
    # Example: second_largest([4, 2, 2, 1])  # returns 2
    distinct = set(numbers)
    if len(distinct) < 2:
        return None
    # Remove the largest element and return the new max
    largest = max(distinct)
    distinct.remove(largest)
    return max(distinct)
```

